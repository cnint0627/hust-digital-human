.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 0;
  position: relative;
  padding-bottom: 140rpx;
}

.header {
  background-color: #ffffff;
  padding: 40rpx 30rpx;
  width: 100%;
  box-sizing: border-box;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  margin-top: 88rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  text-align: center;
}

.record-list {
  padding: 30rpx;
}

.record-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.record-item:active {
  transform: scale(0.98);
  background-color: #fafafa;
}

.record-content {
  flex: 1;
}

.record-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.record-text {
  flex: 1;
}

.record-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 10rpx;
  display: block;
}

.record-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.record-date, .record-time {
  font-size: 24rpx;
  color: #666666;
}

.status-text {
  font-size: 24rpx;
  color: #ff9800;
  background-color: #fff3e0;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 20rpx;
}

.status-finish-text {
  font-size: 24rpx;
  color: #45acd4;
  background-color: #e0faff;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 20rpx;
}

.record-detail {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.record-image {
  width: 200rpx;
  height: 300rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.record-vedio {
  width: 200rpx;
  height: 300rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.record-params {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 4rpx 0;
}
.image-text {
  display: flex;
}

.record-param-text {
  font-size: 24rpx;
  color: #666666;
  background-color: #f5f5f5;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.record-arrow {
  color: #999999;
  font-size: 40rpx;
  font-weight: 300;
  margin-left: 20rpx;
}

.button-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background-color: #ffffff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.back-button {
  background: linear-gradient(135deg, #4CAF50, #45a049);
  border: none;
  padding: 24rpx 32rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.2);
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.button-text {
  color: white;
  font-size: 28rpx;
  font-weight: 500;
}

@supports (padding-bottom: constant(safe-area-inset-bottom)) {
  .button-container {
      padding-bottom: calc(30rpx + constant(safe-area-inset-bottom));
  }
}

@supports (padding-bottom: env(safe-area-inset-bottom)) {
  .button-container {
      padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  }
}